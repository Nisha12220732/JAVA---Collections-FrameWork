package JAVA_FOLDER;

import java.util.*;

public class DequeCode {
    public static void main(String[] args) {
        Deque<Integer> dq = new ArrayDeque<>();
        dq.addFirst(20);
        dq.addLast(15);
        dq.addFirst(25);
        dq.addLast(10);
        dq.addFirst(27);
        dq.addLast(18);
        dq.removeFirst();
        dq.removeLast();
        dq.peekFirst();
        dq.peekLast();
        dq.isEmpty();
        System.out.println(dq);

    }
    
}
